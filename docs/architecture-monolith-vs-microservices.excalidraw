      "isDeleted": false,
      "boundElements": [],
      "updated": 1793220957948,
      "link": null,
      "locked": false,
      "text": "What 'modular monolith' means",
      "originalText": "What 'modular monolith' means",
      "fontSize": 24,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "ac"
    },
    {
      "id": "a_p1_b",
      "type": "text",
      "x": 80,
      "y": 695,
      "width": 427.8,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#3d3d3d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1222328496,
      "version": 2,
      "versionNonce": 882736880,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793220957948,
      "link": null,
      "locked": false,
      "text": "Modular: the code is split into clean modules,\none per agent, with clear boundaries.\nMonolith: all modules are built, tested,\ndeployed and run together as one app.\nModules talk by plain function calls in\nthe same process: fast, no network.",
      "originalText": "Modular: the code is split into clean modules,\none per agent, with clear boundaries.\nMonolith: all modules are built, tested,\ndeployed and run together as one app.\nModules talk by plain function calls in\nthe same process: fast, no network.",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "ad"
    },
    {
      "id": "a_p2",
      "type": "rectangle",
      "x": 850,
      "y": 640,
      "width": 750,
      "height": 175,
      "angle": 0,
      "strokeColor": "#000000",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 1490376254,
      "version": 2,
      "versionNonce": 221390864,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793220957948,
      "link": null,
      "locked": false,
      "index": "ae"
    },
    {
      "id": "a_p2_h",
      "type": "text",
      "x": 870,
      "y": 654,
      "width": 372,
      "height": 30,
      "angle": 0,
      "strokeColor": "#3d3d3d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
