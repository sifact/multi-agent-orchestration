      "version": 2,
      "versionNonce": 879763696,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793220957948,
      "link": null,
      "locked": false,
      "text": "Strengths and pain points",
      "originalText": "Strengths and pain points",
      "fontSize": 24,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "af"
    },
    {
      "id": "a_p2_b",
      "type": "text",
      "x": 870,
      "y": 695,
      "width": 418.5,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#3d3d3d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 721762279,
      "version": 2,
      "versionNonce": 584230416,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793220957948,
      "link": null,
      "locked": false,
      "text": "Good: simple to run, fast, predictable.\nPain: any change ships the whole app.\nPain: one central team owns every agent.\nPain: nothing outside can call a module,\nso other systems duplicate the logic.\nPain: a new experience means forking the app.",
      "originalText": "Good: simple to run, fast, predictable.\nPain: any change ships the whole app.\nPain: one central team owns every agent.\nPain: nothing outside can call a module,\nso other systems duplicate the logic.\nPain: a new experience means forking the app.",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "ag"
    },
    {
      "id": "fb",
      "type": "rectangle",
      "x": 30,
      "y": 890,
      "width": 1600,
      "height": 1010,
      "angle": 0,
      "strokeColor": "#24693a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
