      "updated": 1793220957949,
      "link": null,
      "locked": false,
      "text": "What 'microservice' means",
      "originalText": "What 'microservice' means",
      "fontSize": 24,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b0W"
    },
    {
      "id": "b_p1_b",
      "type": "text",
      "x": 80,
      "y": 1735,
      "width": 418.5,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#3d3d3d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1527129487,
      "version": 2,
      "versionNonce": 444643056,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793220957949,
      "link": null,
      "locked": false,
      "text": "Each capability runs as its own small app.\nIt has its own codebase and release, so a\nteam can change it without touching others.\nOthers use it only through its API, never\nits code, so any language works on each side.\nMany apps can call the same service: reuse.",
      "originalText": "Each capability runs as its own small app.\nIt has its own codebase and release, so a\nteam can change it without touching others.\nOthers use it only through its API, never\nits code, so any language works on each side.\nMany apps can call the same service: reuse.",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b0X"
    },
    {
      "id": "b_p2",
