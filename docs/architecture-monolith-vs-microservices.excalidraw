      "index": "b0Y"
    },
    {
      "id": "b_p2_h",
      "type": "text",
      "x": 870,
      "y": 1694,
      "width": 282.71999999999997,
      "height": 30,
      "angle": 0,
      "strokeColor": "#3d3d3d",
