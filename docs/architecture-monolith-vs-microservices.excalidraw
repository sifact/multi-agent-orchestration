    {
      "id": "a_p1_h",
      "type": "text",
      "x": 80,
      "y": 654,
      "width": 431.52,
      "height": 30,
      "angle": 0,
      "strokeColor": "#3d3d3d",
      "backgroundColor": "transparent",
