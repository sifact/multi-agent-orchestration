      "updated": 1793220957949,
      "link": null,
      "locked": false,
      "text": "Strengths and costs",
      "originalText": "Strengths and costs",
      "fontSize": 24,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b0Z"
    },
    {
      "id": "b_p2_b",
      "type": "text",
      "x": 870,
      "y": 1735,
      "width": 474.3,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#3d3d3d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 831698693,
      "version": 2,
      "versionNonce": 1360391696,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793220957949,
      "link": null,
      "locked": false,
      "text": "Good: one agent, reused by every app.\nGood: each domain team owns and ships its own.\nGood: coordinators and agents use any stack.\nCost: network calls are slower than function calls.\nCost: more moving parts to run and monitor.\nCost: needs shared auth and tracing: the gateway.",
      "originalText": "Good: one agent, reused by every app.\nGood: each domain team owns and ships its own.\nGood: coordinators and agents use any stack.\nCost: network calls are slower than function calls.\nCost: more moving parts to run and monitor.\nCost: needs shared auth and tracing: the gateway.",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b0a"
    },
