   "versionNonce": 502922617,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "2. Unclear ownership: one team kept every agent in one\ncodebase, so domain experts could not own their agent.",
   "originalText": "2. Unclear ownership: one team kept every agent in one\ncodebase, so domain experts could not own their agent.",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "b1_1",
   "lineHeight": 1.25,
   "autoResize": true
  },
