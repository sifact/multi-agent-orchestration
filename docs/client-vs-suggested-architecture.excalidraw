   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "1. No cross-system reuse: agents were tied to the chatbot,\nso other systems duplicated the same capabilities.",
   "originalText": "1. No cross-system reuse: agents were tied to the chatbot,\nso other systems duplicated the same capabilities.",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "b1_0",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
