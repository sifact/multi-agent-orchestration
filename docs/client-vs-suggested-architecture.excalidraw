   "frameId": null,
   "roundness": null,
   "seed": 61172930,
   "version": 1,
   "versionNonce": 441402618,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Product catalog search, inventory\navailability, order management,\ncustomer profiles, knowledge retrieval.\nEach one: its own service, owned by a\ndomain team, behind a standard protocol,\npure domain logic with no UI, reusable\nby any coordinator, and built in any\nstack: SK (C#), LangSmith (Python), custom.",
   "originalText": "Product catalog search, inventory\navailability, order management,\ncustomer profiles, knowledge retrieval.\nEach one: its own service, owned by a\ndomain team, behind a standard protocol,\npure domain logic with no UI, reusable\nby any coordinator, and built in any\nstack: SK (C#), LangSmith (Python), custom.",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
