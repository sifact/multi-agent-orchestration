   "updated": 1,
   "link": null,
   "locked": false,
   "text": "1. Router, with remote agents:\nsame intent routing, but agents\nnow run as remote services.\nGood: an easy first step off\nthe monolith.\nWeak: still one agent per query,\nno combined answers.",
   "originalText": "1. Router, with remote agents:\nsame intent routing, but agents\nnow run as remote services.\nGood: an easy first step off\nthe monolith.\nWeak: still one agent per query,\nno combined answers.",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "d1",
   "lineHeight": 1.25,
   "autoResize": true
  },
