   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Article's verdict: fast and predictable, but not designed for reuse. Each query reaches exactly one agent:\nno multi-agent orchestration, no response synthesis.",
   "originalText": "Article's verdict: fast and predictable, but not designed for reuse. Each query reaches exactly one agent:\nno multi-agent orchestration, no response synthesis.",
