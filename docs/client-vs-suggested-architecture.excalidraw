  {
   "id": "ep2_t",
   "type": "text",
   "x": 600,
   "y": 2355,
   "width": 399.9,
   "height": 150.0,
   "angle": 0,
   "strokeColor": "#3d3d3d",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
