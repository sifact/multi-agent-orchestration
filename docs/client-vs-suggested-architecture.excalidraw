   ],
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "b1_1_t",
   "type": "text",
   "x": 188.9,
   "y": 861.25,
   "width": 502.2,
   "height": 37.5,
   "angle": 0,
   "strokeColor": "#3d3d3d",
   "backgroundColor": "transparent",
