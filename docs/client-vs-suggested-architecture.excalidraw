   "version": 1,
   "versionNonce": 1799645191,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Smoke tests showed notable overhead, even for simple two-agent cases. Test setup: the original prompts and agents moved\nout of the monolith without optimization, to isolate the cost of the architecture itself from prompt improvements.",
   "originalText": "Smoke tests showed notable overhead, even for simple two-agent cases. Test setup: the original prompts and agents moved\nout of the monolith without optimization, to isolate the cost of the architecture itself from prompt improvements.",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
