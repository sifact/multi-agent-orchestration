   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "3. Coordinator (chosen):\nplans which agents to call, in order\nor in parallel, then merges answers.\nGood: reuse, independent deploys.\nWeak: more complex than a router,\nadded latency, and less back-and-forth\nthan group chat.",
   "originalText": "3. Coordinator (chosen):\nplans which agents to call, in order\nor in parallel, then merges answers.\nGood: reuse, independent deploys.\nWeak: more complex than a router,\nadded latency, and less back-and-forth\nthan group chat.",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "d3",
   "lineHeight": 1.25,
   "autoResize": true
  },
