   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Ambitions grew: new AI behaviours across teams, several client experiences, and agent reuse across the company.",
   "originalText": "Ambitions grew: new AI behaviours across teams, several client experiences, and agent reuse across the company.",
