   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why it is built this way",
   "originalText": "Why it is built this way",
   "fontSize": 24,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "ep3_t",
   "type": "text",
   "x": 1120,
   "y": 2355,
   "width": 362.7,
   "height": 150.0,
   "angle": 0,
   "strokeColor": "#3d3d3d",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 120232147,
   "version": 1,
   "versionNonce": 1081622283,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Any coordinator can call any agent:\nthe framework on one side does not\naffect the other.\nThe gateway keeps agents free of\nfront-end auth, so they stay reusable.\nThe coordinator replaces the old\nseparate intent-detection LLM.\nCost: steps 2, 4 and 5 add latency (F).",
   "originalText": "Any coordinator can call any agent:\nthe framework on one side does not\naffect the other.\nThe gateway keeps agents free of\nfront-end auth, so they stay reusable.\nThe coordinator replaces the old\nseparate intent-detection LLM.\nCost: steps 2, 4 and 5 add latency (F).",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
